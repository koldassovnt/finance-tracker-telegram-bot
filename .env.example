# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# family-finance-crm backend, without /api/v1.
BACKEND_URL=http://localhost:8080
# Shared secret; must equal BOT_API_TOKEN in the backend's .env.
BOT_API_TOKEN=

# Timezone for "today" and the daily reminder; the backend uses Asia/Almaty too.
APP_TIMEZONE=Asia/Almaty
# Daily bills reminder, HH:MM in APP_TIMEZONE.
NOTIFY_AT=10:00

# Production only: set to switch from long polling to a webhook.
# WEBHOOK_URL=https://bot.example.com/telegram
# WEBHOOK_SECRET=
# LISTEN_ADDR=:8081
